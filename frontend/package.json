{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "content": "node scripts/build-companion-catalogue.mjs && node scripts/build-content.mjs",
    "predev": "npm run content",
    "dev": "vite",
    "build": "npm run content && vite build && vite build --ssr src/ssr.jsx --outDir .ssr --emptyOutDir && node scripts/prerender.mjs && node scripts/build-agent-access.mjs && node scripts/build-ads-txt.mjs",
    "prelint": "npm run content",
    "lint": "eslint .",
    "preview": "vite preview",
    "test:herbs": "node --test tests/herb-guide.test.mjs",
    "test:map": "node --test tests/visitor-country.test.mjs tests/herb-map.test.mjs tests/local-map-api.test.mjs tests/occurrence.test.mjs tests/map-search.test.mjs",
    "test:motion": "node --test tests/mushroom-motion.test.mjs tests/herb-motion.test.mjs tests/supporter-poems.test.mjs tests/supporter-lifecycle.test.mjs",
    "test:navigation": "node --test tests/navigation.test.mjs",
    "test:seo": "node --test tests/seo.test.mjs",
    "indexnow": "node scripts/submit-indexnow.mjs",
    "test:privacy": "node --test tests/private-queries.test.mjs",
    "test:planning": "node --test tests/field-planning.test.mjs",
    "test:agent": "node --test tests/agent-access.test.mjs tests/agent-build.test.mjs tests/lookalikes.test.mjs"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.104.5",
    "@vercel/functions": "^3.10.3",
    "astronomy-engine": "2.1.19",
    "axios": "^1.20.0",
    "date-fns": "^4.4.0",
    "lucide-react": "^1.61.0",
    "mapbox-gl": "^3.33.0",
    "posthog-js": "^1.438.21",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "web-vitals": "^6.2.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "cheerio": "^1.1.2",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "gray-matter": "^4.0.3",
    "marked": "^18.1.1",
    "tailwindcss": "^4.2.2",
    "vite": "^8.0.4"
  },
  "overrides": {
    "zod": "4.6.6"
  },
  "packageManager": "npm@12.2.1"
}
