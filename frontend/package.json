{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "content": "node scripts/build-content.mjs",
    "predev": "npm run content",
    "dev": "vite",
    "build": "npm run content && vite build && vite build --ssr src/ssr.jsx --outDir .ssr --emptyOutDir && node scripts/prerender.mjs && node scripts/build-ads-txt.mjs",
    "prelint": "npm run content",
    "lint": "eslint .",
    "preview": "vite preview",
    "test:herbs": "node --test tests/herb-guide.test.mjs",
    "test:map": "node --test tests/visitor-country.test.mjs tests/herb-map.test.mjs tests/local-map-api.test.mjs",
    "test:motion": "node --test tests/mushroom-motion.test.mjs",
    "test:navigation": "node --test tests/navigation.test.mjs",
    "test:seo": "node --test tests/seo.test.mjs",
    "indexnow": "node scripts/submit-indexnow.mjs"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.96.2",
    "astronomy-engine": "2.1.19",
    "axios": "^1.19.0",
    "date-fns": "^4.1.0",
    "lucide-react": "^1.31.0",
    "mapbox-gl": "^3.21.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@tailwindcss/vite": "^4.2.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "cheerio": "^1.1.2",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "gray-matter": "^4.0.3",
    "marked": "^16.4.1",
    "tailwindcss": "^4.2.2",
    "vite": "^8.0.4"
  }
}
