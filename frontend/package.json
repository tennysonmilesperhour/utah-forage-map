{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "content": "node scripts/build-content.mjs",
    "predev": "npm run content",
    "dev": "vite",
    "build": "npm run content && vite build && vite build --ssr src/ssr.jsx --outDir .ssr --emptyOutDir && node scripts/prerender.mjs",
    "prelint": "npm run content",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.96.2",
    "axios": "^1.19.0",
    "date-fns": "^4.1.0",
    "lucide-react": "^1.31.0",
    "mapbox-gl": "^3.21.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@tailwindcss/vite": "^4.2.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "cheerio": "^1.1.2",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "gray-matter": "^4.0.3",
    "marked": "^16.4.1",
    "tailwindcss": "^4.2.2",
    "vite": "^8.0.4"
  }
