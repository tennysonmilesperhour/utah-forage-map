VITE_MAPBOX_TOKEN=your-mapbox-token-here

# Google Ads / Analytics and AdSense (all optional; leave unset to keep off).
# Nothing loads and no ads.txt is generated until these are configured, so the
# integration ships ready but inactive.

# Google Ads conversion tracking (loads gtag.js). Format: AW-XXXXXXXXXX
VITE_GOOGLE_ADS_ID=
# Conversion action labels from the Google Ads UI (the part after the slash in
# a "send_to" value). Each conversion stays off until its label is set.
VITE_GOOGLE_ADS_SIGNUP_LABEL=
VITE_GOOGLE_ADS_SUBMIT_LABEL=
# Google Analytics 4 measurement ID. GA stays off until a visitor opts in.
# Format: G-XXXXXXXXXX
VITE_GA_MEASUREMENT_ID=

# Google AdSense publisher account (loads the AdSense loader and generates
# ads.txt at build). Format: ca-pub-0000000000000000
VITE_ADSENSE_CLIENT=
