{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "redirects": [
    {
      "source": "/:path((?!googlef197a076bc0cd35a\\.html|BingSiteAuth\\.xml).*)",
      "has": [
        {
          "type": "host",
          "value": "utah-forage-map.vercel.app"
        }
      ],
      "destination": "https://worldmushroomforaging.org/:path",
      "permanent": true
    },
    {
      "source": "/:path(.*)",
      "has": [
        {
          "type": "host",
          "value": "www.worldmushroomforaging.org"
        }
      ],
      "destination": "https://worldmushroomforaging.org/:path",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/visitor-country",
      "destination": "/api/visitor-country"
    },
    {
      "source": "/api/:path*",
      "destination": "https://utah-forage-api.vercel.app/api/:path*"
    },
    {
      "source": "/community",
      "destination": "/community/index.html"
    },
    {
      "source": "/field-guide",
      "destination": "/field-guide/index.html"
    },
    {
      "source": "/learn",
      "destination": "/learn/index.html"
    },
    {
      "source": "/learn/:path*",
      "destination": "/learn/:path*/index.html"
    },
    {
      "source": "/regions",
      "destination": "/regions/index.html"
    },
    {
      "source": "/regions/:path*",
      "destination": "/regions/:path*/index.html"
    },
    {
      "source": "/about",
      "destination": "/about/index.html"
    },
    {
      "source": "/disclaimer",
      "destination": "/disclaimer/index.html"
    },
    {
      "source": "/herbs/atlas",
      "destination": "/herbs/atlas/index.html"
    },
    {
      "source": "/herbs/atlas/:path*",
      "destination": "/herbs/atlas/:path*/index.html"
    },
    {
      "source": "/herbs/regions",
      "destination": "/herbs/regions/index.html"
    },
    {
      "source": "/herbs/regions/:path*",
      "destination": "/herbs/regions/:path*/index.html"
    },
    {
      "source": "/herbs/fieldcraft",
      "destination": "/herbs/fieldcraft/index.html"
    },
    {
      "source": "/:path*",
      "destination": "/index.html"
    }
  ]
}
