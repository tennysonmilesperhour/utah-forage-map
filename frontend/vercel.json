{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/:path((?!googlef197a076bc0cd35a\\.html|BingSiteAuth\\.xml).*)",
      "has": [
        {
          "type": "host",
          "value": "utah-forage-map.vercel.app"
        }
      ],
      "destination": "https://worldmushroomforaging.org/:path",
      "permanent": true
    },
    {
      "source": "/:path(.*)",
      "has": [
        {
          "type": "host",
          "value": "www.worldmushroomforaging.org"
        }
      ],
      "destination": "https://worldmushroomforaging.org/:path",
      "permanent": true
    },
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/:path*/index.html",
      "destination": "/:path*",
      "permanent": true
    },
    {
      "source": "/learn",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/reference/learn.md",
      "destination": "/reference/library.md",
      "permanent": true
    },
    {
      "source": "/",
      "has": [
        {
          "type": "query",
          "key": "taxon"
        }
      ],
      "destination": "/map",
      "permanent": true
    },
    {
      "source": "/",
      "has": [
        {
          "type": "query",
          "key": "region"
        }
      ],
      "destination": "/map",
      "permanent": true
    },
    {
      "source": "/",
      "has": [
        {
          "type": "query",
          "key": "observation"
        }
      ],
      "destination": "/map",
      "permanent": true
    },
    {
      "source": "/",
      "has": [
        {
          "type": "query",
          "key": "follow"
        }
      ],
      "destination": "/map",
      "permanent": true
    },
    {
      "source": "/",
      "has": [
        {
          "type": "query",
          "key": "verify"
        }
      ],
      "destination": "/map",
      "permanent": true
    },
    {
      "source": "/",
      "has": [
        {
          "type": "query",
          "key": "reset"
        }
      ],
      "destination": "/map",
      "permanent": true
    },
    {
      "source": "/",
      "has": [
        {
          "type": "query",
          "key": "submit"
        }
      ],
      "destination": "/map",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/map",
      "destination": "/map/index.html"
    },
    {
      "source": "/herb-observations",
      "destination": "/api/herb-observations"
    },
    {
      "source": "/herbs/map",
      "destination": "/herbs/map/index.html"
    },
    {
      "source": "/visitor-country",
      "destination": "/api/visitor-country"
    },
    {
      "source": "/api/:path*",
      "destination": "https://utah-forage-api.vercel.app/api/:path*"
    },
    {
      "source": "/community",
      "destination": "/community/index.html"
    },
    {
      "source": "/field-guide",
      "destination": "/field-guide/index.html"
    },
    {
      "source": "/learn/:path*",
      "destination": "/learn/:path*/index.html"
    },
    {
      "source": "/regions",
      "destination": "/regions/index.html"
    },
    {
      "source": "/regions/:path*",
      "destination": "/regions/:path*/index.html"
    },
    {
      "source": "/about",
      "destination": "/about/index.html"
    },
    {
      "source": "/disclaimer",
      "destination": "/disclaimer/index.html"
    },
    {
      "source": "/herbs/atlas",
      "destination": "/herbs/atlas/index.html"
    },
    {
      "source": "/herbs/atlas/:path*",
      "destination": "/herbs/atlas/:path*/index.html"
    },
    {
      "source": "/herbs/regions",
      "destination": "/herbs/regions/index.html"
    },
    {
      "source": "/herbs/regions/:path*",
      "destination": "/herbs/regions/:path*/index.html"
    },
    {
      "source": "/herbs/fieldcraft",
      "destination": "/herbs/fieldcraft/index.html"
    },
    {
      "source": "/herbs",
      "destination": "/herbs/index.html"
    },
    {
      "source": "/account",
      "destination": "/map/index.html"
    },
    {
      "source": "/privacy",
      "destination": "/privacy/index.html"
    }
  ],
  "headers": [
    {
      "source": "/account",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, follow"
        }
      ]
    },
    {
      "source": "/herbs/atlas/compare",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, follow"
        }
      ]
    },
    {
      "source": "/visitor-country",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    },
    {
      "source": "/reference/:path*",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, follow"
        }
      ]
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "query",
          "key": "reset"
        }
      ],
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "query",
          "key": "verify"
        }
      ],
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/indexnow-urls.json",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    }
  ],
  "functions": {
    "api/herb-observations.js": {
      "maxDuration": 30
    }
  }
}
