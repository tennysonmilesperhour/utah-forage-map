DATABASE_URL=sqlite:///./forage_map.db
# PostgreSQL example:
# DATABASE_URL=postgresql://user:password@localhost:5432/forage_map
SECRET_KEY=your-secret-key-here
ENVIRONMENT=development
APP_URL=http://127.0.0.1:5173
CORS_ORIGINS=http://127.0.0.1:5173
ADMIN_EMAILS=you@example.com
LOCATION_PRIVACY_SECRET=use-a-different-long-random-value
CRON_SECRET=use-a-long-random-value
RESEND_API_KEY=
EMAIL_FROM=Forage Map <accounts@your-domain.example>

# iNaturalist import. Defaults cover the whole world; set a box or place IDs to narrow it.
INATURALIST_PAGES=3
INATURALIST_PER_PAGE=100
# INATURALIST_BBOX=swlat,swlng,nelat,nelng
# INATURALIST_PLACE_IDS=6853,7207
